# =============================================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is gitignored — never commit real secrets.
# See the README ("Environment variables") for exactly where each value lives
# in the Supabase dashboard.
# =============================================================================

# --- Supabase API (Project Settings → API) ----------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key (SERVER ONLY — never expose to the browser).
# Used by the seed script and server-side admin actions (invite redemption).
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connection (Connect → ORMs / Drizzle) -------------------------
# Postgres connection string used by Drizzle for migrations + the app.
# Use the "Session pooler" or "Direct connection" URI. Include the password.
# Example: postgresql://postgres.<ref>:<password>@aws-0-...pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Seed configuration -----------------------------------------------------
# Your email — becomes the pre-created teacher account.
TEACHER_EMAIL=

# Password set on the seeded teacher + test student accounts.
SEED_TEST_PASSWORD=password123
